<Window x:Class="WCM.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WCM.Desktop.ViewModels"
        xmlns:views="clr-namespace:WCM.Desktop.Views"
        Title="Windows Cleanup Manager" Height="680" Width="1080" MinHeight="480" MinWidth="720">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ListBox ItemsSource="{Binding Pages}"
             SelectedItem="{Binding SelectedPage}"
             DisplayMemberPath="Title"
             Background="{StaticResource SidebarBrush}"
             BorderThickness="0"
             Padding="8"
             AutomationProperties.Name="Main navigation" />
    <Border Grid.Column="1" Background="{StaticResource ContentBrush}" Padding="24">
      <ContentControl Content="{Binding SelectedPage}" Focusable="False" />
    </Border>
  </Grid>
</Window>
