<UserControl x:Class="WCM.Desktop.Views.ApplicationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Applications" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button Content="_Scan" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
      <Button Content="_Map storage" Command="{Binding MapCommand}" />
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" AutomationProperties.Name="Search applications" ToolTip="Search by name or publisher" />
      <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="190" AutomationProperties.Name="Filter applications" />
    </WrapPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Status, Converter={StaticResource TextToVisible}}" />
      <Border Style="{StaticResource Banner}" Margin="0,6,0,0" Visibility="{Binding Problem, Converter={StaticResource TextToVisible}}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" AutomationProperties.LiveSetting="Assertive" />
      </Border>
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Single" AutomationProperties.Name="Applications">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
          <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" />
          <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource Humanize}}" Width="130" />
          <DataGridTextColumn Header="Detected by" Binding="{Binding DetectionSource}" Width="*" />
          <DataGridTextColumn Header="Review reason" Binding="{Binding ReviewReason}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="No applications to show. Select Scan to find them." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding VisibleCount, Converter={StaticResource ZeroToVisible}}" />
      <TextBlock Grid.Row="1" Text="Storage locations for the selected application" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
      <DataGrid Grid.Row="2" ItemsSource="{Binding Locations}" AutomationProperties.Name="Storage locations">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Path" Binding="{Binding Mapping.Path}" Width="2*" />
          <DataGridTextColumn Header="Type" Binding="{Binding Mapping.DataType, Converter={StaticResource Humanize}}" Width="120" />
          <DataGridTextColumn Header="Size" Binding="{Binding Mapping.SizeBytes, Converter={StaticResource Bytes}}" Width="80" />
          <DataGridTextColumn Header="Evidence level" Binding="{Binding Mapping.Band}" Width="110" />
          <DataGridTextColumn Header="Why it is protected" Binding="{Binding Mapping.ProtectionReason}" Width="*" />
          <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceText}" Width="2*" />
          <DataGridTemplateColumn Header="Is this link right?" Width="170">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Confirm" Command="{Binding ConfirmCommand}" Padding="8,2" Margin="0,0,4,0" />
                  <Button Content="Reject" Command="{Binding RejectCommand}" Padding="8,2" Margin="0" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
