<UserControl x:Class="WCM.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Status, Converter={StaticResource TextToVisible}}" />
      <Border Style="{StaticResource Banner}" Margin="0,6,0,0" Visibility="{Binding Problem, Converter={StaticResource TextToVisible}}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" AutomationProperties.LiveSetting="Assertive" />
      </Border>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Data folder" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Welcome. Choose where WCM keeps its database, logs and quarantine, or keep the suggested folder." Style="{StaticResource Muted}" Margin="0,0,0,8" Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="Running in portable mode. Data is stored beside the program." Style="{StaticResource Muted}" Margin="0,0,0,8" Visibility="{Binding IsPortable, Converter={StaticResource BoolToVisibility}}" />
            <TextBox Text="{Binding DataRoot, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPortable}" AutomationProperties.Name="Data folder" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,8"><Run Text="Quarantine folder:" /> <Run Text="{Binding QuarantineFolder, Mode=OneWay}" /></TextBlock>
            <StackPanel Orientation="Horizontal">
              <Button Content="_Browse" Command="{Binding BrowseDataRootCommand}" />
              <Button Content="Save data _folder" Command="{Binding SaveDataRootCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Appearance and logging" Style="{StaticResource SectionTitle}" />
            <WrapPanel>
              <StackPanel Margin="0,0,16,0">
                <Label Content="_Theme" Target="{Binding ElementName=ThemeBox}" />
                <ComboBox x:Name="ThemeBox" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Width="160" />
              </StackPanel>
              <StackPanel>
                <Label Content="_Logging level" Target="{Binding ElementName=LogBox}" />
                <ComboBox x:Name="LogBox" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedLogLevel}" Width="160" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Scanning and retention" Style="{StaticResource SectionTitle}" />
            <WrapPanel Margin="0,0,0,10">
              <StackPanel Margin="0,0,16,0">
                <Label Content="Maximum scan _concurrency (1 to 16)" Target="{Binding ElementName=ConcurrencyBox}" />
                <TextBox x:Name="ConcurrencyBox" Text="{Binding Concurrency}" Width="100" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel>
                <Label Content="Quarantine _retention reminder (days)" Target="{Binding ElementName=RetentionBox}" />
                <TextBox x:Name="RetentionBox" Text="{Binding RetentionDays}" Width="100" HorizontalAlignment="Left" />
              </StackPanel>
            </WrapPanel>
            <TextBlock Text="Retention never deletes anything automatically." Style="{StaticResource Muted}" Margin="0,0,0,10" />
            <TextBlock Text="Scan locations" FontWeight="SemiBold" Margin="0,0,0,6" />
            <DataGrid ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}" SelectionMode="Single" MaxHeight="240" AutomationProperties.Name="Scan locations">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                <DataGridTextColumn Header="Policy" Binding="{Binding Policy}" Width="*" />
                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
              <Button Content="_Add location" Command="{Binding AddRootCommand}" />
              <Button Content="Remove locatio_n" Command="{Binding RemoveRootCommand}" />
              <Button Content="_Save settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock Text="Always excluded" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Exclusions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Protected paths" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Your additions. Windows, Program Files, your documents, browser profiles, databases and source code are always protected." Style="{StaticResource Muted}" Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding ProtectedPaths}" SelectedItem="{Binding SelectedProtected}" MinHeight="60" MaxHeight="140" Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Protected paths" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Add _protected path" Command="{Binding AddProtectedCommand}" />
              <Button Content="Remove protected pat_h" Command="{Binding RemoveProtectedCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Local cleanup rules" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="All rules start off. Enabling one only makes its items eligible for preview. You still approve every plan." Style="{StaticResource Muted}" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding Rules}" MaxHeight="300" AutomationProperties.Name="Cleanup rules">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="On" Width="45">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Rule.RuleId}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Rule" Binding="{Binding Rule.RuleId}" Width="130" />
                <DataGridTextColumn Header="Category" Binding="{Binding Rule.Category}" Width="130" />
                <DataGridTextColumn Header="Target" Binding="{Binding Rule.Target}" Width="2*" />
                <DataGridTextColumn Header="Rebuild cost" Binding="{Binding Rule.RebuildCost}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Export" Style="{StaticResource SectionTitle}" />
            <Button Content="_Export settings" Command="{Binding ExportCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
