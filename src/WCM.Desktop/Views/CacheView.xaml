<UserControl x:Class="WCM.Desktop.Views.CacheView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Cache Analyzer" Style="{StaticResource PageTitle}" />
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,4,0,12" Text="Only folders named by a local rule appear here. Nothing is selected for you, and rules stay off until you enable them in Settings." />
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button Content="Pre_view selected" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" />
      <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="190" AutomationProperties.Name="Filter by category" />
    </WrapPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Status, Converter={StaticResource TextToVisible}}" />
      <Border Style="{StaticResource Banner}" Margin="0,6,0,0" Visibility="{Binding Problem, Converter={StaticResource TextToVisible}}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" AutomationProperties.LiveSetting="Assertive" />
      </Border>
    </StackPanel>
    <Grid>
      <DataGrid ItemsSource="{Binding Items}" AutomationProperties.Name="Cache candidates">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Select" Width="60">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Candidate.IsEligible}" AutomationProperties.Name="Select item" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Category" Binding="{Binding Candidate.Category, Converter={StaticResource Humanize}}" Width="140" />
          <DataGridTextColumn Header="Application" Binding="{Binding Candidate.ApplicationKey}" Width="110" />
          <DataGridTextColumn Header="Path" Binding="{Binding Candidate.Path}" Width="2*" />
          <DataGridTextColumn Header="Size" Binding="{Binding Candidate.SizeBytes, Converter={StaticResource Bytes}}" Width="80" />
          <DataGridCheckBoxColumn Header="Must close app" Binding="{Binding Candidate.RequiresApplicationClosed}" Width="100" />
          <DataGridTextColumn Header="Rebuild cost" Binding="{Binding Candidate.RebuildCost}" Width="*" />
          <DataGridTextColumn Header="Status" Binding="{Binding Candidate.Reason}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Nothing found. Run a full scan first." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisible}}" />
    </Grid>
  </DockPanel>
</UserControl>
