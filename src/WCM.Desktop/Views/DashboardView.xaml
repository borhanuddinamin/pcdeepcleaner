<UserControl x:Class="WCM.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Dashboard" Style="{StaticResource PageTitle}" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding LastScan}" Style="{StaticResource Muted}" Margin="0,4,0,12" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Button Content="_Run full scan" Command="{Binding FullScanCommand}" Style="{StaticResource PrimaryButton}" />
      <Button Content="_Cancel" Command="{Binding CancelCommand}" />
    </StackPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Margin="0,0,0,12" Visibility="{Binding Notice, Converter={StaticResource TextToVisible}}">
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Status, Converter={StaticResource TextToVisible}}" />
      <Border Style="{StaticResource Banner}" Margin="0,6,0,0" Visibility="{Binding Problem, Converter={StaticResource TextToVisible}}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" AutomationProperties.LiveSetting="Assertive" />
      </Border>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Width="240" MinHeight="120" Margin="0,0,12,12">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" Margin="0,6" />
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="12" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
