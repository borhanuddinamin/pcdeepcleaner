<UserControl x:Class="WCM.Desktop.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Scan History" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <ComboBox ItemsSource="{Binding ReportKinds}" SelectedItem="{Binding Report}" Width="190" Margin="0,0,8,0" AutomationProperties.Name="Report type" />
      <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" Width="80" Margin="0,0,8,0" AutomationProperties.Name="Report format" />
      <Button Content="_Export report" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" />
    </WrapPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Status, Converter={StaticResource TextToVisible}}" />
      <Border Style="{StaticResource Banner}" Margin="0,6,0,0" Visibility="{Binding Problem, Converter={StaticResource TextToVisible}}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" AutomationProperties.LiveSetting="Assertive" />
      </Border>
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DataGrid Grid.ColumnSpan="3" ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}" SelectionMode="Single" AutomationProperties.Name="Scans">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, Converter={StaticResource LocalTime}}" Width="140" />
          <DataGridTextColumn Header="Finished" Binding="{Binding CompletedAt, Converter={StaticResource LocalTime}}" Width="140" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource Humanize}}" Width="*" />
          <DataGridTextColumn Header="Files" Binding="{Binding FilesScanned, StringFormat=N0}" Width="90" />
          <DataGridTextColumn Header="Folders" Binding="{Binding FoldersScanned, StringFormat=N0}" Width="90" />
          <DataGridTextColumn Header="Size" Binding="{Binding TotalBytes, Converter={StaticResource Bytes}}" Width="90" />
          <DataGridTextColumn Header="Unreadable" Binding="{Binding Errors, StringFormat=N0}" Width="85" />
          <DataGridTextColumn Header="Links" Binding="{Binding LinksSkipped, StringFormat=N0}" Width="60" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" Text="Unreadable items in the selected scan" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="Audit history" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
      <DataGrid Grid.Row="2" ItemsSource="{Binding Errors}" AutomationProperties.Name="Unreadable items">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" />
          <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid Grid.Row="2" Grid.Column="2" ItemsSource="{Binding AuditEntries}" AutomationProperties.Name="Audit history">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=g}" Width="130" />
          <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
          <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*" />
          <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
