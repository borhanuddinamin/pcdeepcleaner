<UserControl x:Class="WCM.Desktop.Views.StorageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Storage Explorer" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button Content="_Scan storage" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
      <Button Content="_Cancel" Command="{Binding CancelCommand}" />
      <Button Content="_Open folder" Command="{Binding OpenCommand}" />
      <Button Content="_Up" Command="{Binding UpCommand}" />
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" AutomationProperties.Name="Search paths" />
      <Button Content="Searc_h" Command="{Binding SearchCommand}" />
    </WrapPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" />
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Status, Converter={StaticResource TextToVisible}}" />
      <Border Style="{StaticResource Banner}" Margin="0,6,0,0" Visibility="{Binding Problem, Converter={StaticResource TextToVisible}}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" AutomationProperties.LiveSetting="Assertive" />
      </Border>
    </StackPanel>
    <Expander DockPanel.Dock="Bottom" Header="Not scanned" Margin="0,12,0,0" Foreground="{DynamicResource TextBrush}">
      <ItemsControl ItemsSource="{Binding NotScanned}" AutomationProperties.Name="Folders not scanned">
        <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Location}" Style="{StaticResource SectionTitle}" />
    <Grid>
      <DataGrid ItemsSource="{Binding Folders}" SelectedItem="{Binding Selected}" SelectionMode="Single" AutomationProperties.Name="Folders">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*" />
          <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="70" />
          <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource Bytes}}" Width="80" />
          <DataGridTextColumn Header="Owners" Binding="{Binding Owners}" Width="*" />
          <DataGridTextColumn Header="Data type" Binding="{Binding DataType, Converter={StaticResource Humanize}}" Width="120" />
          <DataGridTextColumn Header="Score" Binding="{Binding Confidence}" Width="55" />
          <DataGridTextColumn Header="Protection" Binding="{Binding OwnershipStatus, Converter={StaticResource Humanize}}" Width="150" />
          <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedAt, Converter={StaticResource LocalTime}}" Width="130" />
          <DataGridCheckBoxColumn Header="Partly read" Binding="{Binding IsPartial}" Width="75" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="No folders to show. Run a scan, or select a folder and open it." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding Folders.Count, Converter={StaticResource ZeroToVisible}}" />
    </Grid>
  </DockPanel>
</UserControl>
