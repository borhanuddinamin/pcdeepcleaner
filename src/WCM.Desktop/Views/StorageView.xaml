<UserControl x:Class="WCM.Desktop.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel MaxWidth="800" HorizontalAlignment="Left">
    <TextBlock Text="Storage Explorer" Style="{StaticResource PageTitle}" />
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <Button Content="_Scan storage" Command="{Binding ScanCommand}" Padding="16,4" Margin="0,0,8,0" />
      <Button Content="_Cancel" Command="{Binding CancelCommand}" Padding="16,4" />
    </StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis"
               Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,16" />
    <TextBlock Text="Not scanned" FontWeight="SemiBold" Margin="0,0,0,4" />
    <ItemsControl ItemsSource="{Binding NotScanned}" AutomationProperties.Name="Folders not scanned">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
