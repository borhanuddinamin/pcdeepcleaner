<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="SidebarBrush" Color="{x:Static SystemColors.ControlColor}" />
  <SolidColorBrush x:Key="ContentBrush" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{x:Static SystemColors.GrayTextColor}" />

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
</ResourceDictionary>
